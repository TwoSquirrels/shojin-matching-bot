# Discord Bot Token
# Get your token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Discord Client ID
DISCORD_CLIENT_ID=your_client_id_here

# Discord Guild ID (Optional, for development)
DISCORD_GUILD_ID=your_guild_id_here

# MongoDB Database URL
# Format: mongodb+srv://username:password@host/database?retryWrites=true&w=majority
# Local MongoDB: mongodb://localhost:27017/shojin-matching-bot
# MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/shojin-matching-bot
DATABASE_URL=mongodb://localhost:27017/shojin-matching-bot
